# Snyk (https://snyk.io) policy file
#
# Snyk Code ignores are managed in the Snyk web UI per Snyk's docs:
# "Ignoring issues or vulnerabilities using the .snyk file is not supported
#  for Snyk Code." The block below excludes paths from scanning entirely —
# test suites, immutable migration history, vendored JS bundles, false-
# positive sites in i18n keymaps, local dev helpers.
version: v1.0.0
# Open-source vulnerability ignores (client-side policy applied by `snyk test`).
ignore:
  # NOTE: the former SNYK-PYTHON-OAUTHLIB-20305255 (Timing Attack in oauthlib,
  # High) ignore was removed once it became remediable. databricks-sql-connector
  # relaxed its oauthlib cap to <5.0.0 (4.7.0, the pinned floor, already allows
  # it) and requests-oauthlib 2.0.0 allows oauthlib>=3.0.0, so oauthlib was
  # upgraded 3.3.1 -> 4.0.0 (the fix version) in uv.lock. No ignore needed.
  # Command Injection in simple-git / @simple-git/argv-parser (Critical). Pulled
  # in ONLY as a dev/build-tooling transitive:
  #   nuxt > @nuxt/devtools > simple-git > @simple-git/argv-parser
  # @nuxt/devtools is the local development UI; it uses simple-git to read repo
  # info while running `nuxt dev` on a developer's machine. It is NOT part of the
  # production runtime: `nuxt build` emits `.output/`, which the prod image runs
  # directly, and @nuxt/devtools / simple-git never ship in that artifact. The
  # injection requires attacker-controlled arguments to git commands; the only
  # inputs here are the developer's own local repo during dev, never attacker-
  # controlled production request data. No upgrade remediates it in this tree:
  # the fix lands only in simple-git 4.0.0, but every @nuxt/devtools release
  # (stable up to 3.4.2; latest tag 4.0.0-beta.2) pins simple-git ^3.x, and
  # forcing simple-git 4.x breaks the build — @nuxt/devtools does
  # `import Git from 'simple-git'` and simple-git 4 removed its default export.
  # Resolved by the Nuxt 4 / @nuxt/devtools upgrade. Time-boxed for re-review.
  SNYK-JS-SIMPLEGIT-20335524:
    - '*':
        reason: >-
          Dev/build-only transitive (nuxt dev via @nuxt/devtools); not in the
          production .output runtime. No fix installable: simple-git 4.0.0 fixes
          it but all @nuxt/devtools releases pin simple-git ^3.x and v4 breaks
          the build (default export removed). Re-review on Nuxt 4 upgrade.
        expires: 2026-12-21T00:00:00.000Z
  SNYK-JS-SIMPLEGIT-20335531:
    - '*':
        reason: >-
          Dev/build-only transitive (nuxt dev via @nuxt/devtools); not in the
          production .output runtime. No fix installable: simple-git 4.0.0 fixes
          it but all @nuxt/devtools releases pin simple-git ^3.x and v4 breaks
          the build (default export removed). Re-review on Nuxt 4 upgrade.
        expires: 2026-12-21T00:00:00.000Z
  SNYK-JS-SIMPLEGIT-20335540:
    - '*':
        reason: >-
          Dev/build-only transitive (nuxt dev via @nuxt/devtools); not in the
          production .output runtime. No fix installable: simple-git 4.0.0 fixes
          it but all @nuxt/devtools releases pin simple-git ^3.x and v4 breaks
          the build (default export removed). Re-review on Nuxt 4 upgrade.
        expires: 2026-12-21T00:00:00.000Z
  SNYK-JS-SIMPLEGITARGVPARSER-20335528:
    - '*':
        reason: >-
          Dev/build-only transitive (nuxt dev via @nuxt/devtools > simple-git);
          not in the production .output runtime. No fix installable: the fix is
          @simple-git/argv-parser 2.0.1 (simple-git 4.x), but all @nuxt/devtools
          releases pin simple-git ^3.x and v4 breaks the build (default export
          removed). Re-review on Nuxt 4 upgrade.
        expires: 2026-12-21T00:00:00.000Z
  # Improper Verification of Cryptographic Signature in node-forge (CVSS 8.7).
  # Pulled in ONLY as a build/dev-tooling transitive:
  #   nuxt > @nuxt/cli > listhen > node-forge
  # listhen uses node-forge solely to mint a self-signed cert for the local
  # `nuxt dev --https` server. node-forge is NOT part of the production runtime:
  # `nuxt build` emits `.output/`, which the prod image runs directly, and the
  # Nuxt CLI / listhen / node-forge never ship in that artifact. Every published
  # node-forge version is flagged (semver: '*') and there is no upstream fix or
  # patch available (fixedIn: []), so no upgrade can remediate it. Time-boxed so
  # it is re-evaluated once an upstream fix lands or the dep chain drops it.
  SNYK-JS-NODEFORGE-19635204:
    - '*':
        reason: >-
          Dev/build-only transitive (nuxt dev CLI self-signed cert generation via
          listhen); not present in the production .output runtime. No fixed
          node-forge version exists (all versions affected, no patch). Re-review
          on expiry.
        expires: 2026-12-07T00:00:00.000Z
  # Uncontrolled Recursion in braces (High). Reached ONLY through build-time
  # tooling, never the shipped browser bundle:
  #   @nuxt/ui > @nuxtjs/tailwindcss > tailwindcss > chokidar|fast-glob >
  #     micromatch > braces        (Tailwind CSS generation at build time)
  #   nuxt > nitropack > globby > fast-glob > micromatch > braces
  #     (Nitro build-time file globbing)
  # The recursion is driven by adversarial brace-expansion patterns; the only
  # inputs braces sees here are the project's own globs / watched paths during
  # `nuxt build`, never attacker-controlled runtime data, and braces does not
  # execute in the production .output server. Every braces version is flagged
  # (fixedIn: []), so no upgrade remediates it; the vulnerable chain is dropped
  # by the Nuxt 4 upgrade. Time-boxed for re-review.
  SNYK-JS-BRACES-19963945:
    - '*':
        reason: >-
          Build-time-only transitive (Tailwind CSS generation and Nitro file
          globbing via micromatch); not in the production .output runtime. No
          fixed braces version exists (all versions affected). Re-review on
          expiry or when the Nuxt 4 upgrade drops the chain.
        expires: 2026-12-21T00:00:00.000Z
  # Prototype Pollution in deepmerge (High). Build-time-only transitive:
  #   nuxt > nitropack > @rollup/plugin-node-resolve > deepmerge
  # deepmerge runs inside the Rollup/Nitro bundler during `nuxt build`, merging
  # bundler configuration objects only. Exploiting prototype pollution requires
  # attacker-controlled objects to be merged; the production .output server
  # never invokes this code path on request data. Every deepmerge version is
  # flagged (fixedIn: []), so no upgrade remediates it; resolved by the Nuxt 4
  # upgrade. Time-boxed for re-review.
  SNYK-JS-DEEPMERGE-19964053:
    - '*':
        reason: >-
          Build-time-only transitive (Rollup/Nitro bundler config merge); not in
          the production .output runtime request path. No fixed deepmerge version
          exists (all versions affected). Re-review on expiry or when the Nuxt 4
          upgrade drops the chain.
        expires: 2026-12-21T00:00:00.000Z
  # Uncontrolled Recursion in ioredis (High). Pulled in transitively as an
  # OPTIONAL Nitro storage driver:
  #   nuxt > nitropack > ioredis
  # ioredis is loaded only when a Redis storage mount is configured. This
  # deployment configures no Redis storage (frontend/nuxt.config.ts sets no
  # nitro.storage redis driver; default storage is memory/filesystem), so the
  # module is never instantiated at runtime. The only fix is 6.0.0-beta.1;
  # forcing a pre-release ioredis into the Nitro server is riskier than the
  # dormant finding. Re-review when a stable ioredis 6.x ships or Nuxt 4 lands.
  SNYK-JS-IOREDIS-19963957:
    - '*':
        reason: >-
          Dormant optional Nitro storage driver; no Redis storage is configured
          in this deployment, so ioredis is never loaded at runtime. Only fix is
          a pre-release (6.0.0-beta.1). Re-review on expiry.
        expires: 2026-12-21T00:00:00.000Z
  # Multiple HIGH-severity DoS-class advisories in the Apache Thrift Python
  # library, all fixed only in thrift 0.25.0:
  #   - Improper Handling of Length Parameter Inconsistency (SNYK-PYTHON-THRIFT-20417151)
  #   - Allocation of Resources Without Limits/Throttling — unbounded recursion
  #     on skipped unknown fields (SNYK-PYTHON-THRIFT-20417194)
  #   - Allocation of Resources Without Limits/Throttling — TJSONProtocol string
  #     length not enforced (SNYK-PYTHON-THRIFT-20571226)
  #   - Data Amplification — TZlibTransport decompression limit not enforced
  #     (SNYK-PYTHON-THRIFT-20571816)
  #   - Infinite loop — TNonblockingServer frame-boundary busy-loop
  #     (SNYK-PYTHON-THRIFT-20571817)
  # Pulled in ONLY as a transitive of the Databricks connector:
  #   databricks-sql-connector > thrift
  # thrift is reached exclusively by app/data_sources/clients/databricks_sql_client.py,
  # which opens a CLIENT connection to a customer-configured Databricks SQL
  # Warehouse (server_hostname + http_path, authenticated with the customer's own
  # access token over HTTPS) and deserializes that warehouse's Thrift responses.
  # This backend runs NO Thrift server, so the TNonblockingServer infinite-loop
  # path (20571817) is never instantiated; the remaining advisories are Thrift
  # protocol/transport deserialization of data received from that peer — the
  # customer's own trusted Databricks endpoint over TLS, never attacker-
  # controlled inbound request data to this backend. No installable fix exists
  # in this tree: fixed only in thrift 0.25.0, but EVERY published
  # databricks-sql-connector release — including the latest 4.6.0 — hard-caps
  # thrift>=0.24.0,<0.25.0, so no upgrade can remediate it without dropping the
  # Databricks connector. Directly analogous to the oauthlib/databricks entry
  # above. Time-boxed; re-review when databricks-sql-connector relaxes its
  # thrift cap.
  SNYK-PYTHON-THRIFT-20417151:
    - '*':
        reason: >-
          No installable fix (fixed in thrift 0.25.0; databricks-sql-connector
          hard-caps thrift<0.25.0 on all versions incl. latest 4.6.0). Reached
          only via the Databricks connector deserializing responses from the
          customer's own trusted Databricks SQL Warehouse over TLS, never
          attacker-controlled inbound request data. Re-review when the databricks
          cap relaxes.
        expires: 2026-12-21T00:00:00.000Z
  SNYK-PYTHON-THRIFT-20417194:
    - '*':
        reason: >-
          No installable fix (fixed in thrift 0.25.0; databricks-sql-connector
          hard-caps thrift<0.25.0 on all versions incl. latest 4.6.0). Reached
          only via the Databricks connector deserializing responses from the
          customer's own trusted Databricks SQL Warehouse over TLS, never
          attacker-controlled inbound request data. Re-review when the databricks
          cap relaxes.
        expires: 2026-12-21T00:00:00.000Z
  SNYK-PYTHON-THRIFT-20571226:
    - '*':
        reason: >-
          No installable fix (fixed in thrift 0.25.0; databricks-sql-connector
          hard-caps thrift<0.25.0 on all versions incl. latest 4.6.0). TJSONProtocol
          string-length DoS reached only via the Databricks connector deserializing
          responses from the customer's own trusted Databricks SQL Warehouse over
          TLS, never attacker-controlled inbound request data. Re-review when the
          databricks cap relaxes.
        expires: 2026-12-21T00:00:00.000Z
  SNYK-PYTHON-THRIFT-20571816:
    - '*':
        reason: >-
          No installable fix (fixed in thrift 0.25.0; databricks-sql-connector
          hard-caps thrift<0.25.0 on all versions incl. latest 4.6.0). TZlibTransport
          data-amplification DoS reached only via the Databricks connector
          deserializing responses from the customer's own trusted Databricks SQL
          Warehouse over TLS, never attacker-controlled inbound request data.
          Re-review when the databricks cap relaxes.
        expires: 2026-12-21T00:00:00.000Z
  SNYK-PYTHON-THRIFT-20571817:
    - '*':
        reason: >-
          No installable fix (fixed in thrift 0.25.0; databricks-sql-connector
          hard-caps thrift<0.25.0 on all versions incl. latest 4.6.0). Infinite-loop
          DoS is in TNonblockingServer; this backend runs no Thrift server and uses
          thrift only as a client via the Databricks connector, so the path is not
          reached. Re-review when the databricks cap relaxes.
        expires: 2026-12-21T00:00:00.000Z
  # Regular Expression Denial of Service (ReDoS) in picomatch (High, CVSS 8.7).
  # Reached ONLY through build-time glob/auto-import tooling in the frontend
  # (Nuxt), never the shipped browser bundle or the production .output server.
  # All 47 introduction paths run picomatch inside Nuxt build/dev machinery, e.g.:
  #   nuxt > unimport > picomatch                 (build-time auto-imports)
  #   nuxt > unplugin-vue-router > picomatch       (build-time route generation)
  #   @nuxt/ui|nuxt-echarts|... > @nuxt/kit > tinyglobby > picomatch
  #                                                (build-time file globbing)
  #   @nuxt/ui > @nuxt/icon > picomatch            (build-time icon resolution)
  # The ReDoS is driven by adversarial glob patterns; the only inputs picomatch
  # sees here are the project's own globs / module paths during `nuxt build`,
  # never attacker-controlled runtime request data, and picomatch does not run
  # in the production .output server. picomatch 4.0.4 is the latest release and
  # every version is flagged (fixedIn: []), so no upgrade remediates it; the
  # upgradable paths require major bumps (nuxt 4.x / nuxt-tiptap-editor 3.x) and
  # are resolved by the Nuxt 4 upgrade. Mirrors the frontend/.snyk entry.
  # Time-boxed for re-review.
  SNYK-JS-PICOMATCH-21248802:
    - '*':
        reason: >-
          Build-time-only transitive (Nuxt auto-imports / route generation /
          file globbing via unimport, unplugin-vue-router, tinyglobby and
          @nuxt/icon); not in the production .output runtime request path. No
          fixed picomatch version exists (4.0.4 is latest, all versions
          affected). Re-review on expiry or when the Nuxt 4 upgrade drops the
          chain.
        expires: 2026-12-21T00:00:00.000Z
  # Files or Directories Accessible to External Parties in @nuxt/vite-builder
  # (High, CVSS 8.2, CVE-2026-119199 / GHSA-648h-gw55-m2g7). The flaw is in the
  # Vite DEV SERVER's filesystem access controls (packages/vite/src/vite.ts):
  # it fails to deny requests for the Nitro dev-server output directory, so an
  # attacker who can reach a running `nuxt dev` server could read compiled
  # server-side code and secrets. Introduced via:
  #   nuxt > @nuxt/vite-builder
  # The vulnerable path executes ONLY under `nuxt dev` — a long-running Vite dev
  # server on a developer's machine. It is NOT in the production runtime: this
  # app is an SSR-disabled Nuxt 3 SPA built with `nuxt generate`, which emits a
  # static bundle under .output/public that the Dockerfile copies to
  # /app/frontend/dist and serves as static files through FastAPI — the prod
  # image ships no Vite/Nitro dev server and no Node runtime. The only requests
  # the dev server answers are the developer's own localhost traffic, never
  # attacker-controlled production input. Unlike the other entries here a fix
  # does exist (@nuxt/vite-builder 4.6.3), but vite-builder's major version
  # tracks nuxt's and cannot be forced to 4.x under nuxt 3 — it is the same
  # Nuxt 4 major upgrade these entries are all deferred to. Time-boxed for
  # re-review with the rest of the Nuxt 4 cohort.
  SNYK-JS-NUXTVITEBUILDER-22132207:
    - '*':
        reason: >-
          Dev-server-only flaw in @nuxt/vite-builder's Vite dev server
          filesystem access controls; the path runs only under `nuxt dev`,
          never in production, which ships a static `nuxt generate` .output
          served by FastAPI (no Vite/Nitro dev server, no Node runtime). Fix is
          @nuxt/vite-builder 4.6.3 (the Nuxt 4 major upgrade) and cannot be
          forced under nuxt 3. Deferred to the Nuxt 4 upgrade; re-review on
          expiry.
        expires: 2026-12-21T00:00:00.000Z
  # Allocation of Resources Without Limits or Throttling in flat (High,
  # CVSS 8.2, SNYK-JS-FLAT-22148819). Mirrors the frontend/.snyk entry.
  # flat.unflatten() sizes an array from the largest numeric segment of a key,
  # so a crafted key with a huge index (e.g. "a.1e9") forces an unbounded
  # allocation. Introduced as a transitive of the Markdown-Components renderer:
  #   @nuxtjs/mdc > remark-mdc > flat
  # Unlike the other JS entries here, this one DOES run in the production
  # bundle: the <MDC> component renders markdown through remark-mdc in the
  # browser (components/report/ArtifactChatBubble.vue, the instruction/prompt
  # panels, and the public /c/[token] shared view), so MDC-rendered content —
  # LLM output and user-authored instruction/prompt text — reaches flat. Impact
  # is bounded and client-side only: this is a resource-exhaustion DoS (CVSS
  # A:H, C:N/I:N) that can hang or crash the VIEWER'S OWN browser tab — no
  # server-side impact, no confidentiality/integrity impact, and the tab is
  # recoverable by reload. Triggering needs a crafted pathological nested key
  # (AC:H) and no exploit is known in the wild (exploitMaturity: none). No
  # upgrade or patch remediates it: every flat version is flagged
  # (fixedIn: [], semver '*'), 6.0.1 is the latest release, and the latest
  # @nuxtjs/mdc (0.23.2) / remark-mdc (3.11.1) still depend on flat ^6.0.1, so
  # neither an upgrade nor a yarn resolution clears it. Accepted and time-boxed;
  # re-review when upstream flat ships a fix or remark-mdc drops/guards it.
  SNYK-JS-FLAT-22148819:
    - '*':
        reason: >-
          Runtime transitive of the MDC markdown renderer
          (@nuxtjs/mdc > remark-mdc > flat). Client-side resource-exhaustion
          DoS only (CVSS A:H, C:N/I:N): a crafted pathological key passed to
          flat.unflatten can hang the viewer's own browser tab, with no
          server-side or data-exposure impact and recovery by reload; needs
          crafted input (AC:H) and no known exploit. No fix exists (all flat
          versions affected, 6.0.1 is latest; latest @nuxtjs/mdc / remark-mdc
          still pin flat ^6.0.1), so no upgrade or resolution remediates it.
          Re-review when upstream flat ships a fix.
        expires: 2026-12-21T00:00:00.000Z
exclude:
  code:
    - 'backend/tests'
    - 'backend/tests/**'
    - 'backend/tests/**/*'
    - '**/spider_eval.py'
    - 'frontend/tests'
    - 'frontend/tests/**'
    - 'backend/alembic/versions'
    - 'backend/alembic/versions/**'
    - 'frontend/public/libs'
    - 'frontend/public/libs/**'
    - 'frontend/pages/agents/*/evals.vue'
    - 'frontend/pages/evals/index.vue'
    - 'frontend/pages/old_agents'
    - 'frontend/pages/old_agents/**'
    - 'frontend/.repro'
    - 'frontend/.repro/**'
    - 'scripts/pw-shot.js'
    # Local dev/verification/seed harnesses: standalone scripts that log in to a
    # localhost instance with throwaway test credentials. Not imported by the
    # application (backend/app) and never shipped. Hardcoded localhost logins
    # here are intentional test fixtures, not production secrets.
    - 'backend/scripts'
    - 'backend/scripts/**'
    - 'backend/email_sandbox'
    - 'backend/email_sandbox/**'
    - 'tools'
    - 'tools/**'
    # Feedback-loop harnesses: standalone reproduce/verify scripts (seed, launch,
    # probe, and a localhost-only git/HTTP server) that drive a local BOW instance
    # for a documented bug/feature loop. Not imported by the application
    # (backend/app) and never shipped; the throwaway localhost servers here bind
    # 127.0.0.1 with test fixtures, not production request handlers.
    - 'docs/feedback-loops'
    - 'docs/feedback-loops/**'
