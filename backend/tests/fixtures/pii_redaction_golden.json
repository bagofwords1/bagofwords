          "action": "block"
        }
      },
      "custom_rules": [
        {
          "id": "emp",
          "name": "Employee ID",
          "patterns": [
            "EMP-\\d{4}",
            "E\\d{6}"
          ],
          "replacement": "[EMP]",
          "enabled": true
        },
        {
          "id": "off",
          "name": "Disabled",
          "patterns": [
            "revenue"
          ],
          "replacement": "[X]",
          "enabled": false
        }
      ]
    },
