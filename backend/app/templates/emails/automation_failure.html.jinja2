<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}">
<head>
  <meta charset="utf-8">
  <title>{{ subject }}</title>
</head>
<body style="margin:0; padding:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; color:#222; font-size:14px; line-height:1.6;" dir="{{ dir }}">
  <div style="max-width:600px; padding:20px;" dir="{{ dir }}">
    <p>{{ t.greeting }}</p>
    <p>{{ intro_sentence }}</p>
    {% if hint %}
    <p>{{ hint }}</p>
    {% endif %}
    {% if error_message %}
    <p style="margin:16px 0; padding:12px; background:#f6f6f6; border-inline-start:3px solid #d9534f; color:#444; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:12px; white-space:pre-wrap;">{{ error_message }}</p>
    {% endif %}
    {% if next_run_sentence %}
    <p style="color:#666;">{{ next_run_sentence }}</p>
    {% endif %}
    <p><a href="{{ link }}">{{ t.cta_text }}</a></p>
    <p style="color:#999;">{{ t.footer }}</p>
  </div>
</body>
</html>
